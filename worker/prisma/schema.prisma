generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "workerd"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int          @id @default(autoincrement())
  telegramId  BigInt       @unique
  username    String?
  createdAt   DateTime     @default(now())
  periods     Period[]
  paydayRules PaydayRule[]
  categories  Category[]
  exchanges   Exchange[]
}

// Обмен валюты: отдали fromAmount одной валюты, получили toAmount другой.
// Курс не хранится — он выводится из пары сумм. Обмен не трата: он лишь
// пополняет «кошелёк» иностранной валюты, из которого потом идут траты.
// Привязан к пользователю, а не к периоду: партия валюты спокойно переживает
// границу периода, и FIFO считается по сквозной истории.
model Exchange {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  fromCurrency String
  fromAmount   Decimal  @db.Decimal(14, 2)
  toCurrency   String
  toAmount     Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())

  @@index([userId, date])
}

// Категории трат задаёт сам пользователь. Два независимых флага решают, где
// учитывать траты этой категории: inStats — вкладка «Статистика», inBalance —
// банка и остаток текущего периода. Трата без категории учитывается везде.
model Category {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String
  inStats   Boolean   @default(true)
  inBalance Boolean   @default(true)
  createdAt DateTime  @default(now())
  expenses  Expense[]

  @@index([userId])
}

// История правил зарплатного месяца. Каждое правило действует с effectiveFrom
// (конкретная дата-граница) до effectiveFrom следующего правила (если есть).
// При сохранении нового правила все более поздние (effectiveFrom >=) удаляются —
// так работает применение "задним числом" и пересчёт вперёд от выбранной даты.
model PaydayRule {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // 'DAY_OF_MONTH' | 'FIRST_WEEKDAY'
  dayOfMonth    Int? // для DAY_OF_MONTH: 1-31 (31 в феврале = последний день месяца)
  weekday       Int? // для FIRST_WEEKDAY: 0=воскресенье..6=суббота
  effectiveFrom DateTime // граница, с которой действует это правило
  createdAt     DateTime @default(now())

  @@index([userId, effectiveFrom])
}

model Period {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  totalSum  Decimal   @db.Decimal(10, 2)
  createdAt DateTime  @default(now())
  expenses  Expense[]

  @@index([userId, startDate])
}

model Expense {
  id       Int      @id @default(autoincrement())
  periodId Int
  period   Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  // сумма в валюте currency: для RUB это рубли, для VND — донги.
  // Рублёвая стоимость траты в иностранной валюте не хранится: она считается
  // по FIFO из истории обменов, иначе забытый задним числом обмен оставил бы
  // часть трат с неверным курсом навсегда.
  amount     Decimal   @db.Decimal(14, 2)
  currency   String    @default("RUB")
  date       DateTime  @default(now())
  note       String?
  // удаление категории не трогает траты — они становятся «без категории»
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([periodId, date])
  @@index([categoryId])
}
